# Variables de la stack (à saisir dans Dockhand), ou fichier .env pour essayer en local
APP_SECRET=remplacer-par-openssl-rand-hex-32
# Premier compte de l'interface, créé au premier démarrage s'il n'en existe aucun (ensuite inutile, à retirer).
# Sans ADMIN_PASSWORD, le premier compte se crée depuis l'interface.
# Mot de passe : 12 caractères minimum, minuscule, majuscule, chiffre et caractère spécial.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Un-mot-de-passe-solide-2026!
FREEBOX_URL=http://mafreebox.freebox.fr

# Notifications push : contact donné aux services de push (facultatif)
# PUSH_SUBJECT=mailto:toi@exemple.fr

# Réglages avancés (valeurs par défaut)
# POLL_CONNECTION_SECONDS=10
# POLL_DEVICES_SECONDS=30
# POLL_SYSTEM_SECONDS=60
# POLL_TRAFFIC_SECONDS=30
# TEMP_ALERT_CELSIUS=85
# RETENTION_RAW_DAYS=7
# RETENTION_MINUTE_DAYS=90
# RETENTION_EVENT_DAYS=365
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Adresse de ce serveur vue par la Freebox (notifications de la box), réglable aussi dans l'interface
# PUBLIC_URL=http://192.168.1.20:8086
